// JTAS — Jaraa Task & Accountability System
// Authoritative schema: SDD section 3.3. Every DateTime is stored in UTC.

generator client {
  provider      = "prisma-client-js"
  // native is the machine that runs `prisma generate`. The musl target is the
  // EC2 image: the Mac build is arm64, and the container that runs it is amd64.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerations — SDD section 3.2
// ---------------------------------------------------------------------------

enum Role {
  MD
  DEPUTY_MD
  ADMIN
  MEMBER
}

enum JobStatus {
  DRAFT
  IN_PROGRESS
  AT_RISK
  DELAYED
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SubtaskStatus {
  PENDING
  BLOCKED
  IN_PROGRESS
  PROBLEM
  AWAITING_APPROVAL
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProblemSeverity {
  LOW
  MEDIUM
  HIGH
  BLOCKER
}

enum ProblemStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  REJECTED
}

enum NotifType {
  SUBTASK_ASSIGNED
  SUBTASK_REASSIGNED
  DEADLINE_REMINDER
  OVERDUE_MEMBER
  OVERDUE_MD
  PROBLEM_RAISED
  PROBLEM_RESOLVED
  DEADLINE_CHANGED
  EXTENSION_REQUESTED
  APPROVAL_REQUIRED
  JOB_COMPLETED
  DAILY_DIGEST_MD
  /// M10: somebody wrote your name in a comment. In-app only — a mention is
  /// a nudge, not an escalation, and mailing every one would make the mail
  /// that does matter harder to see.
  COMMENT_MENTION
  /// The predecessor finished and this subtask is no longer blocked.
  /// Mailed to the assignee so they know they can start.
  READY_TO_START
  /// The department's turn has arrived and they have 24 hours to commit a date.
  COMMITMENT_OPEN
  /// Six hours before that window closes.
  COMMITMENT_REMINDER
  /// The window closed with no date and no problem. Sent to the assignee.
  COMMITMENT_MISSED_MEMBER
  /// The same miss, sent to the MD and deputies.
  COMMITMENT_MISSED_MD
  /// A date was committed. Sent to the assignee of the next task.
  COMMITMENT_MADE
  /// The MD moved a date. Sent to the assignee of the next task, with both dates.
  PREDECESSOR_DATE_CHANGED
}

/// Who fixed a subtask's date. A null deadline has no origin.
enum DeadlineOrigin {
  /// The department committed it when their turn arrived.
  DEPARTMENT
  /// The MD set or overrode it.
  MD
}

enum NotifChannel {
  EMAIL
  IN_APP
  WHATSAPP
  SMS
  /// A second delivery of the same event. Email is still sent. WhatsApp later
  /// is another value here, not a new pipeline.
  TELEGRAM
}

enum NotifStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

// ---------------------------------------------------------------------------
// Core directory
// ---------------------------------------------------------------------------

model Department {
  id            String    @id @default(cuid())
  code          String    @unique // PLANNING, PURCHASE, ...
  name          String
  sequenceOrder Int // 1..8, the default CNC flow order
  isActive      Boolean   @default(true)
  users         User[]
  subtasks      Subtask[]
}

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  phone              String?
  passwordHash       String
  role               Role
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  isActive           Boolean     @default(true)
  /// Seeded demonstration or showcase account, not a real person.
  ///
  /// Additive to SDD section 3.3, and the companion to `Job.isDemo`. That flag
  /// stopped the sweeper chasing demonstration *work*; this one stops it
  /// mailing demonstration *people*. Both are needed, because recipients are
  /// chosen by role rather than by job: `pnpm seed:demo` and
  /// `pnpm seed:showcase` each create an MD, so every digest and every overdue
  /// escalation was addressed to three Managing Directors, two of which do not
  /// exist. Against Mailpit that is invisible; against a real relay it is two
  /// hard bounces per escalation, counted against the sending reputation of
  /// the one address that does exist.
  isDemo             Boolean     @default(false)
  mustChangePassword Boolean     @default(true)
  failedLoginCount   Int         @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  /// Telegram chat that this person linked themselves. Null means no Telegram
  /// messages are attempted. A chat id is not a signed-in session: anyone
  /// holding that phone can press the buttons. See docs/TELEGRAM.md.
  telegramChatId     String?     @unique
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  createdJobs        Job[]               @relation("JobCreator")
  assignedSubtasks   Subtask[]           @relation("SubtaskAssignee")
  notifications      Notification[]
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]
  telegramLinkCodes  TelegramLinkCode[]
  telegramPendings   TelegramPending[]

  @@index([role, isActive])
}

/// Refresh-token families (SDD section 8.2). Rotation on use; reuse of a
/// consumed token invalidates the whole family. Added in M1.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, familyId])
  @@index([familyId])
}

// ---------------------------------------------------------------------------
// Work
// ---------------------------------------------------------------------------

model Job {
  id              String    @id @default(cuid())
  jobCode         String    @unique // JGE-2026-0001
  title           String
  customerName    String?
  partNumber      String?
  drawingNumber   String?
  quantity        Int?
  priority        Priority  @default(NORMAL)
  description     String?
  overallDeadline DateTime // stored UTC
  status          JobStatus @default(DRAFT)
  publishedAt     DateTime?
  completedAt     DateTime?

  /// Seeded demonstration data, not real work.
  ///
  /// Additive to SDD section 3.3. `pnpm seed:demo` generates a year of history
  /// so the dashboards have something to aggregate, and most of it is overdue
  /// by construction — without this flag the sweeper would chase every row of
  /// it, which is thousands of real emails the moment SMTP points at a relay.
  /// The sweeper and the digest both exclude it.
  isDemo          Boolean   @default(false)
  createdById     String
  createdBy       User      @relation("JobCreator", fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subtasks    Subtask[]
  attachments Attachment[]

  @@index([status, overallDeadline])
  @@index([jobCode])
  // The sweeper filters on this on every pass, so it is worth an index.
  @@index([isDemo])
}

/// Per-calendar-year counter backing job-code generation (SDD 4.1).
/// Incremented with SELECT ... FOR UPDATE inside the job-insert transaction.
model JobCodeCounter {
  year Int @id
  last Int @default(0)
}

model Subtask {
  id           String     @id @default(cuid())
  jobId        String
  job          Job        @relation(fields: [jobId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  assigneeId   String
  assignee     User       @relation("SubtaskAssignee", fields: [assigneeId], references: [id])

  title               String
  description         String?
  /// Null until the department commits a date, or the MD sets one.
  /// A row that already had a date when this became optional stays committed.
  deadline            DateTime?
  /// DEPARTMENT when the assignee committed it, MD when he set or moved it.
  /// Null while there is no date. Existing dates are backfilled as DEPARTMENT.
  deadlineOrigin      DeadlineOrigin?
  /// When the 24-hour commitment window closes. Null until their turn arrives,
  /// and left in place afterwards as the record of when they were asked.
  commitmentDueAt     DateTime?
  /// Separate from the work-overdue clock, so a missed commitment does not
  /// burn the escalations a later real deadline is entitled to.
  commitmentEscalationCount   Int       @default(0)
  commitmentLastEscalatedAt   DateTime?
  reminderLeadMinutes Int       @default(360) // 6 hours
  requiresApproval    Boolean   @default(false)
  dependsOnId         String?
  dependsOn           Subtask?  @relation("Dep", fields: [dependsOnId], references: [id])
  dependents          Subtask[] @relation("Dep")

  status          SubtaskStatus @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  completionNote  String?
  escalationCount Int           @default(0)
  lastEscalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems          Problem[]
  comments          Comment[]
  attachments       Attachment[]
  deadlineChanges   DeadlineChange[]
  extensionRequests ExtensionRequest[]

  @@index([assigneeId, status, deadline])
  @@index([status, deadline]) // the scheduler's hot index
  @@index([jobId])
}

model Problem {
  id             String          @id @default(cuid())
  subtaskId      String
  subtask        Subtask         @relation(fields: [subtaskId], references: [id])
  raisedById     String
  description    String // min 20 chars enforced in service
  severity       ProblemSeverity @default(MEDIUM)
  status         ProblemStatus   @default(OPEN)
  acknowledgedAt DateTime?
  mdActionNote   String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())

  @@index([status, createdAt])
  @@index([subtaskId])
}

model DeadlineChange {
  id          String   @id @default(cuid())
  subtaskId   String
  subtask     Subtask  @relation(fields: [subtaskId], references: [id])
  /// Null when the MD set the first date on a task that had none.
  oldDeadline DateTime?
  newDeadline DateTime
  reason      String
  changedById String
  createdAt   DateTime @default(now())

  @@index([subtaskId])
}

model ExtensionRequest {
  id                String    @id @default(cuid())
  subtaskId         String
  subtask           Subtask   @relation(fields: [subtaskId], references: [id])
  requestedById     String
  requestedDeadline DateTime
  reason            String
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById       String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([subtaskId])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Collaboration
// ---------------------------------------------------------------------------

model Comment {
  id        String   @id @default(cuid())
  subtaskId String
  subtask   Subtask  @relation(fields: [subtaskId], references: [id])
  userId    String
  body      String
  createdAt DateTime @default(now())

  @@index([subtaskId, createdAt])
}

model Attachment {
  id           String   @id @default(cuid())
  jobId        String?
  job          Job?     @relation(fields: [jobId], references: [id])
  subtaskId    String?
  subtask      Subtask? @relation(fields: [subtaskId], references: [id])
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  /// Soft delete (build spec M10.5, architecture rule 6).
  ///
  /// Additive to SDD section 3.3. A drawing removed from a job is part of why
  /// the job was built the way it was; the row and the object both stay, and
  /// every query filters on this instead.
  deletedAt    DateTime?
  deletedById  String?

  @@index([jobId])
  @@index([subtaskId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Notifications and governance
// ---------------------------------------------------------------------------

model Notification {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  type         NotifType
  channel      NotifChannel
  subject      String
  body         String
  entityType   String // 'SUBTASK' | 'JOB' | 'PROBLEM'
  entityId     String
  dedupeKey    String       @unique // idempotency guarantee
  scheduledFor DateTime
  sentAt       DateTime?
  // When the sweeper gave up, not when it last retried. The health check counts
  // these over the last hour (M11.4): a rate, so that a handful of dead
  // addresses from last year does not read as an outage today.
  failedAt     DateTime?
  status       NotifStatus  @default(PENDING)
  attemptCount Int          @default(0)
  lastError    String?
  readAt       DateTime?
  createdAt    DateTime     @default(now())

  @@index([status, scheduledFor])
  @@index([userId, readAt])
  @@index([entityType, entityId])
  @@index([status, failedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // SUBTASK_COMPLETED, DEADLINE_EXTENDED...
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  onBehalfOf String? // set when DEPUTY_MD acts for MD
  /// WEB for a signed-in session, TELEGRAM for a linked chat. A chat id is
  /// weaker identification than a session. See docs/TELEGRAM.md.
  source     String   @default("WEB")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

/// A one-time code a person sends the bot to link their own chat.
model TelegramLinkCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// What the bot is waiting for this chat to type or confirm.
///
/// A commitment is written only after the member confirms the resolved date.
/// The proposed date lives here, not in the button, so the confirmation and
/// the write cannot disagree.
model TelegramPending {
  chatId    String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FOCUS, SEVERITY, PROBLEM_LOW, PROBLEM_MEDIUM, PROBLEM_HIGH, OTHER, CONFIRM, FILE, or REJECT.
  kind      String
  subtaskId String
  /// IST wall-clock `YYYY-MM-DDTHH:mm`, set while a commitment waits for confirm.
  deadline  String?
  expiresAt DateTime

  @@index([userId])
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique // date only, IST
  name String
}

model Setting {
  key   String @id
  value Json
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

model JobTemplate {
  id       String            @id @default(cuid())
  name     String
  isActive Boolean           @default(true)
  items    JobTemplateItem[]
}

model JobTemplateItem {
  id                   String      @id @default(cuid())
  templateId           String
  template             JobTemplate @relation(fields: [templateId], references: [id])
  departmentId         String
  title                String
  offsetHoursBeforeDue Int // 240 = 10 days before job deadline
  reminderLeadMinutes  Int         @default(360)
  dependsOnItemOrder   Int?
  order                Int

  @@index([templateId, order])
}
