# ---------------------------------------------------------------------------
# JTAS environment. Copy to .env.local for development.
# Every variable in SDD section 10.3 is documented here. Never commit .env*.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# PostgreSQL 16. Matches docker-compose.yml credentials.
DATABASE_URL="postgresql://jtas:jtas@localhost:5432/jtas_dev?schema=public"

# --- Queue ----------------------------------------------------------------
# Redis 7, used by BullMQ for the scheduler and notification dispatcher.
REDIS_URL="redis://localhost:6379"

# --- Auth -----------------------------------------------------------------
# Two independent secrets, >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-access-token-secret-at-least-32-chars"
REFRESH_SECRET="change-me-refresh-token-secret-at-least-32-chars"

# --- Application ----------------------------------------------------------
# Absolute origin, used to build deep links inside notification emails.
APP_BASE_URL="http://localhost:3000"
# The server process runs in UTC; IST is applied explicitly in lib/utils/time.ts.
TZ="UTC"
NODE_ENV="development"

# --- Mail -----------------------------------------------------------------
# Development defaults point at the Mailpit container (no auth, no TLS).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="JTAS <jtas@jaraaglobal.com>"

# --- File storage (S3-compatible; M10) ------------------------------------
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="jtas-attachments"
S3_KEY=""
S3_SECRET=""

# --- Observability --------------------------------------------------------
SENTRY_DSN=""
LOG_LEVEL="info"

# --- Scheduler ------------------------------------------------------------
# Sweeper cadence in minutes (SDD section 5.2).
SCHEDULER_INTERVAL_MINUTES="5"
