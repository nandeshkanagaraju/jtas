# ---------------------------------------------------------------------------
# JTAS environment. Copy to .env.local for development.
# Every variable in SDD section 10.3 is documented here. Never commit .env*.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# PostgreSQL 16. Matches docker-compose.yml credentials.
DATABASE_URL="postgresql://jtas:jtas@localhost:5432/jtas_dev?schema=public"

# --- Queue ----------------------------------------------------------------
# Redis 7, used by BullMQ for the scheduler and notification dispatcher.
REDIS_URL="redis://localhost:6379"

# --- Auth -----------------------------------------------------------------
# Two independent secrets, >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-access-token-secret-at-least-32-chars"
REFRESH_SECRET="change-me-refresh-token-secret-at-least-32-chars"

# --- Application ----------------------------------------------------------
# Absolute origin, used to build deep links inside notification emails.
APP_BASE_URL="http://localhost:3000"
# The server process runs in UTC; IST is applied explicitly in lib/utils/time.ts.
TZ="UTC"
NODE_ENV="development"

# --- Mail -----------------------------------------------------------------
# Development defaults point at the Mailpit container (no auth, no TLS).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="JTAS <jtas@jaraaglobal.com>"

# --- Mail provider (M12) --------------------------------------------------
# Which EMAIL adapter the registry resolves to. `smtp` is the default so local
# development keeps sending to Mailpit and nothing about a dev setup changes.
# `brevo` uses Brevo's transactional HTTP API. See docs/MAIL_SETUP.md.
MAIL_PROVIDER="smtp"

# Brevo transactional API key, required only when MAIL_PROVIDER=brevo.
# Brevo -> SMTP & API -> API keys. Never commit this.
BREVO_API_KEY=""

# The from-address. Must be verified in Brevo as a single sender, or every send
# is refused. Accepts a bare address or the `Name <address>` form.
#
# A Gmail from-address proves the plumbing works and nothing about domain
# deliverability: SPF/DKIM/DMARC on jaraaglobal.com is a GO-LIVE PREREQUISITE,
# with the exact records in docs/MAIL_SETUP.md section 5.
MAIL_FROM_NAME="JTAS"

# --- Mail guards (M12) ----------------------------------------------------
# Recipient allowlist, comma-separated. While it is non-empty, ONLY these
# addresses receive mail; everything else is written SUPPRESSED with the reason
# on the row and still appears in that user's in-app inbox, so a flow can be
# tested end to end without a message leaving the building. Empty disables the
# guard, which is the production posture once the roster is real.
#
# Matched on the FULL address. A plus-tag is part of the mailbox here:
# `you+hr@gmail.com` is NOT covered by `you@gmail.com` being listed, even
# though Gmail delivers both to one inbox. That is deliberate — see
# tests/unit/mail-guard.test.ts.
MAIL_ALLOWLIST="nandeshjeyalakshmi@gmail.com,nandeshkanagaraju@gmail.com"

# Daily send ceiling, counted over the IST day on rows that actually went out.
# 250 leaves headroom under Brevo's free 300/day. On reaching it the sweeper
# stops dispatching and leaves rows PENDING — not FAILED — so they go out after
# midnight. Remaining quota is on /api/health.
MAIL_DAILY_CAP="250"

# --- Seeded roster addresses ----------------------------------------------
# All ten seeded accounts, each overridable so pointing a department at a real
# mailbox later is a change here and nothing more. Left unset, each falls back
# to its go-live @jaraaglobal.com address in prisma/seed-data/users.ts.
#
# ALL TEN are IGNORED when NODE_ENV=production, with a warning naming the ones
# that were set: a machine that happens to carry these and then seeds the
# client's database would otherwise make a personal address the Managing
# Director of record.
SEED_MD_EMAIL=""
SEED_ADMIN_EMAIL=""
SEED_PLANNING_EMAIL=""
SEED_PURCHASE_EMAIL=""
SEED_STORE_EMAIL=""
SEED_MEMBER_EMAIL=""
SEED_QUALITY_EMAIL=""
SEED_DISPATCH_EMAIL=""
SEED_ACCOUNTS_EMAIL=""
SEED_HR_EMAIL=""

# --- Local container runtime ----------------------------------------------
# The docker context this project's stack lives in. `pnpm dev`, `pnpm worker`
# and the seed scripts refuse to start when another runtime is answering on the
# database port, because two runtimes hold volumes of the same name and the
# wrong one looks exactly like a fresh, empty database. Set to empty to skip
# the check (native PostgreSQL, or CI).
JTAS_DOCKER_CONTEXT="colima"

# --- File storage (S3-compatible; M10) ------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="jtas-attachments"
S3_KEY="jtas"
S3_SECRET="jtas-local-dev"

# --- Observability --------------------------------------------------------
SENTRY_DSN=""
LOG_LEVEL="info"

# --- Scheduler ------------------------------------------------------------
# Sweeper cadence in minutes (SDD section 5.2).
SCHEDULER_INTERVAL_MINUTES="5"
