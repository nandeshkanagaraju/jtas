# Production environment for the EC2 instance. Copy to .env on the server only.
# Do not copy the laptop .env. Generate new secrets with:
#   openssl rand -base64 48
#
# No AWS access keys. The backup container uses the instance role.

# Public name, derived from the Elastic IP:
#   13.232.84.149  ->  13-232-84-149.sslip.io
# APP_BASE_URL is set to https://${JTAS_DOMAIN} by docker-compose.prod.yml.
JTAS_DOMAIN=13-232-84-149.sslip.io
JTAS_FILES_DOMAIN=files.13-232-84-149.sslip.io
ACME_EMAIL=you@example.com

POSTGRES_USER=jtas
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=jtas

JWT_SECRET=replace-with-openssl-rand-base64-48
REFRESH_SECRET=replace-with-a-different-openssl-rand-base64-48

MINIO_ROOT_USER=jtas
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
S3_BUCKET=jtas-attachments
S3_REGION=ap-south-1

AWS_REGION=ap-south-1
BACKUP_BUCKET=jtas-backups
BACKUP_RETENTION_DAYS=30
BACKUP_AT_UTC=19:30

MAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM=JTAS <jtas@jaraaglobal.com>
MAIL_FROM_NAME=JTAS
MAIL_ALLOWLIST=
MAIL_DAILY_CAP=250

# Telegram. Token from BotFather. Secret is any long random string
# (openssl rand -hex 32). Username is the bot's name without @.
# All three stay in this file. They are not part of the image.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

SENTRY_DSN=
LOG_LEVEL=info
SCHEDULER_INTERVAL_MINUTES=5

# Built on the Mac for linux/amd64. Pin a tag or a digest; do not build this
# image on the instance. GHCR_PULL_TOKEN is read:packages only. It is used by
# scripts/deploy.sh to docker login on the host. Compose does not pass it
# into the app or the worker.
GHCR_USER=nandeshkanagaraju
GHCR_PULL_TOKEN=
JTAS_IMAGE=ghcr.io/nandeshkanagaraju/jtas:REPLACE_WITH_GIT_SHA
