# Production environment for the EC2 instance. Copy to .env on the server only.
# Do not copy the laptop .env. Generate new secrets with:
#   openssl rand -base64 48
#
# No AWS access keys. The backup container uses the instance role.

# Public name, derived from the Elastic IP:
#   13.232.84.149  ->  13-232-84-149.sslip.io
# APP_BASE_URL is set to https://${JTAS_DOMAIN} by docker-compose.prod.yml.
JTAS_DOMAIN=13-232-84-149.sslip.io
JTAS_FILES_DOMAIN=files.13-232-84-149.sslip.io
ACME_EMAIL=you@example.com

POSTGRES_USER=jtas
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=jtas

JWT_SECRET=replace-with-openssl-rand-base64-48
REFRESH_SECRET=replace-with-a-different-openssl-rand-base64-48

MINIO_ROOT_USER=jtas
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
S3_BUCKET=jtas-attachments
S3_REGION=ap-south-1

AWS_REGION=ap-south-1
BACKUP_BUCKET=jtas-backups
BACKUP_RETENTION_DAYS=30
BACKUP_AT_UTC=19:30

MAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM=JTAS <jtas@jaraaglobal.com>
MAIL_FROM_NAME=JTAS
MAIL_ALLOWLIST=
MAIL_DAILY_CAP=250

SENTRY_DSN=
LOG_LEVEL=info
SCHEDULER_INTERVAL_MINUTES=5
