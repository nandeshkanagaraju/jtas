// JTAS — Jaraa Task & Accountability System
// Authoritative schema: SDD section 3.3. Every DateTime is stored in UTC.

generator client {
  provider      = "prisma-client-js"
  // native is the machine that runs `prisma generate`. The musl target is the
  // EC2 image: the Mac build is arm64, and the container that runs it is amd64.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerations — SDD section 3.2
// ---------------------------------------------------------------------------

enum Role {
  MD
  DEPUTY_MD
  ADMIN
  MEMBER
  /// Shop-floor supervisor. Signs in only to the production entry pages
  /// (/production); every JTAS page and action is closed to this role.
  SUPERVISOR
}

enum JobStatus {
  DRAFT
  IN_PROGRESS
  AT_RISK
  DELAYED
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SubtaskStatus {
  PENDING
  BLOCKED
  IN_PROGRESS
  PROBLEM
  AWAITING_APPROVAL
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProblemSeverity {
  LOW
  MEDIUM
  HIGH
  BLOCKER
}

enum ProblemStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  REJECTED
}

enum NotifType {
  SUBTASK_ASSIGNED
  SUBTASK_REASSIGNED
  DEADLINE_REMINDER
  OVERDUE_MEMBER
  OVERDUE_MD
  PROBLEM_RAISED
  PROBLEM_RESOLVED
  DEADLINE_CHANGED
  EXTENSION_REQUESTED
  APPROVAL_REQUIRED
  JOB_COMPLETED
  DAILY_DIGEST_MD
  /// M10: somebody wrote your name in a comment. In-app only — a mention is
  /// a nudge, not an escalation, and mailing every one would make the mail
  /// that does matter harder to see.
  COMMENT_MENTION
  /// The predecessor finished and this subtask is no longer blocked.
  /// Mailed to the assignee so they know they can start.
  READY_TO_START
  /// The department's turn has arrived and they have 24 hours to commit a date.
  COMMITMENT_OPEN
  /// Six hours before that window closes.
  COMMITMENT_REMINDER
  /// The window closed with no date and no problem. Sent to the assignee.
  COMMITMENT_MISSED_MEMBER
  /// The same miss, sent to the MD and deputies.
  COMMITMENT_MISSED_MD
  /// A date was committed. Sent to the assignee of the next task.
  COMMITMENT_MADE
  /// The MD moved a date. Sent to the assignee of the next task, with both dates.
  PREDECESSOR_DATE_CHANGED
  /// A date was committed or moved upstream. Sent to the departments two and
  /// three steps further down the route, so they can plan ahead. (The very
  /// next department already gets COMMITMENT_MADE or PREDECESSOR_DATE_CHANGED.)
  UPSTREAM_DATE_UPDATE
  /// The morning "coming your way" mail: every job heading towards this
  /// department, where it is now, and when it is expected to arrive.
  DEPARTMENT_LOOKAHEAD
  /// One department tells another something they need to act on: Store has
  /// recorded material in or out (to Production and Planning), or Planning
  /// asks Accounts to raise the invoice. The row's subject and body are the
  /// message.
  DEPARTMENT_INTIMATION
}

/// Who fixed a subtask's date. A null deadline has no origin.
enum DeadlineOrigin {
  /// The department committed it when their turn arrived.
  DEPARTMENT
  /// The MD set or overrode it.
  MD
}

enum NotifChannel {
  PUSH
  EMAIL
  IN_APP
  WHATSAPP
  SMS
  /// A second delivery of the same event. Email is still sent. WhatsApp later
  /// is another value here, not a new pipeline.
  TELEGRAM
}

enum NotifStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

// ---------------------------------------------------------------------------
// Core directory
// ---------------------------------------------------------------------------

model Department {
  id            String    @id @default(cuid())
  code          String    @unique // PLANNING, PURCHASE, ...
  name          String
  sequenceOrder Int // 1..8, the default CNC flow order
  isActive      Boolean   @default(true)
  users         User[]
  subtasks      Subtask[]
}

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  phone              String?
  passwordHash       String
  role               Role
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  isActive           Boolean     @default(true)
  /// Seeded demonstration or showcase account, not a real person.
  ///
  /// Additive to SDD section 3.3, and the companion to `Job.isDemo`. That flag
  /// stopped the sweeper chasing demonstration *work*; this one stops it
  /// mailing demonstration *people*. Both are needed, because recipients are
  /// chosen by role rather than by job: `pnpm seed:demo` and
  /// `pnpm seed:showcase` each create an MD, so every digest and every overdue
  /// escalation was addressed to three Managing Directors, two of which do not
  /// exist. Against Mailpit that is invisible; against a real relay it is two
  /// hard bounces per escalation, counted against the sending reputation of
  /// the one address that does exist.
  isDemo             Boolean     @default(false)
  mustChangePassword Boolean     @default(false)
  failedLoginCount   Int         @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  /// Telegram chat that this person linked themselves. Null means no Telegram
  /// messages are attempted. A chat id is not a signed-in session: anyone
  /// holding that phone can press the buttons. See docs/TELEGRAM.md.
  telegramChatId     String?     @unique
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  createdJobs       Job[]              @relation("JobCreator")
  contactForJobs    Job[]              @relation("JobPointOfContact")
  assignedSubtasks  Subtask[]          @relation("SubtaskAssignee")
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  telegramLinkCodes TelegramLinkCode[]
  telegramPendings  TelegramPending[]
  signInRequests    SignInRequest[]

  materialCounts MaterialCount[] @relation("MaterialCountRecordedBy")
  invoices       Invoice[]       @relation("InvoiceCreatedBy")
  storeEntries   StoreEntry[]    @relation("StoreEntryRecordedBy")
  batchesAdded   SubtaskBatch[]  @relation("SubtaskBatchCreatedBy")
  intimatedJobs  Job[]           @relation("JobAccountsIntimatedBy")
  stockOpenings  StockOpening[]  @relation("StockOpeningSetBy")
  stockMovements StockMovement[] @relation("StockMovementRecordedBy")

  /// For a SUPERVISOR: the book they keep. Null lets them keep both.
  productionSection         ProductionSection?
  productionReports         ProductionReport[] @relation("ProductionReportSupervisor")
  approvedProductionReports ProductionReport[] @relation("ProductionReportApprover")
  productionPartsAdded      ProductionPart[]   @relation("ProductionPartAddedBy")
  productionHours           ProductionHour[]   @relation("ProductionHourRecordedBy")
  productionChanges         ProductionChange[] @relation("ProductionChangeBy")

  @@index([role, isActive])
}

/// Where a sign-in-link request stands.
enum SignInRequestStatus {
  /// Waiting for the developer to accept or decline.
  PENDING
  /// Accepted: a one-time link was mailed to the person.
  APPROVED
  /// Declined by the developer.
  REJECTED
  /// The mailed link was used to sign in.
  USED
  /// Replaced by a newer request from the same person, or never answered.
  EXPIRED
}

/// A request to sign in by emailed link instead of a password.
///
/// The person types their email on the login page; the developer accepts it
/// in the app; a single-use link goes to that person's mailbox. Only hashes of
/// the browser's polling handle and of the link are stored.
model SignInRequest {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         SignInRequestStatus @default(PENDING)
  /// SHA-256 of the handle the requesting browser polls with.
  pollHash       String              @unique
  /// SHA-256 of the mailed link token. Set on approval.
  linkHash       String?             @unique
  rememberDevice Boolean             @default(false)
  ipAddress      String?
  userAgent      String?
  /// A pending request nobody answered by now is treated as expired.
  expiresAt      DateTime
  decidedAt      DateTime?
  decidedById    String?
  linkExpiresAt  DateTime?
  usedAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([status, createdAt])
  @@index([userId, status])
}

/// Refresh-token families (SDD section 8.2). Rotation on use; reuse of a
/// consumed token invalidates the whole family. Added in M1.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, familyId])
  @@index([familyId])
}

// ---------------------------------------------------------------------------
// Work
// ---------------------------------------------------------------------------

model Job {
  id              String    @id @default(cuid())
  jobCode         String    @unique // JGE-2026-0001
  title           String
  customerName    String?
  partNumber      String?
  drawingNumber   String?
  quantity        Int?
  priority        Priority  @default(NORMAL)
  description     String?
  overallDeadline DateTime // stored UTC
  status          JobStatus @default(DRAFT)
  publishedAt     DateTime?
  completedAt     DateTime?

  /// Seeded demonstration data, not real work.
  ///
  /// Additive to SDD section 3.3. `pnpm seed:demo` generates a year of history
  /// so the dashboards have something to aggregate, and most of it is overdue
  /// by construction — without this flag the sweeper would chase every row of
  /// it, which is thousands of real emails the moment SMTP points at a relay.
  /// The sweeper and the digest both exclude it.
  isDemo      Boolean @default(false)
  createdById String
  createdBy   User    @relation("JobCreator", fields: [createdById], references: [id])

  /// The one department person who speaks to the customer about this job.
  /// Nobody else contacts the customer. Chosen when the job is created; null
  /// only on jobs created before this existed.
  pointOfContactId String?
  pointOfContact   User?   @relation("JobPointOfContact", fields: [pointOfContactId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Deleted from every screen by the MD, deputy or a job manager. Only a
  /// cancelled job or a draft can be deleted. The row is kept, so the audit
  /// trail, comments and files still point somewhere, and it can be restored.
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  /// Planning told Accounts this job is ready to invoice. Null until then.
  accountsIntimatedAt    DateTime?
  accountsIntimatedById  String?
  accountsIntimatedBy    User?     @relation("JobAccountsIntimatedBy", fields: [accountsIntimatedById], references: [id])
  /// What Planning wrote with it: quantity sent, DC number, anything Accounts needs.
  accountsIntimationNote String?

  subtasks    Subtask[]
  attachments Attachment[]
  invoices    Invoice[]

  @@index([status, overallDeadline])
  @@index([jobCode])
  // The sweeper filters on this on every pass, so it is worth an index.
  @@index([isDemo])
  @@index([deletedAt])
}

/// Per-calendar-year counter backing job-code generation (SDD 4.1).
/// Incremented with SELECT ... FOR UPDATE inside the job-insert transaction.
model JobCodeCounter {
  year Int @id
  last Int @default(0)
}

model Subtask {
  id           String     @id @default(cuid())
  jobId        String
  job          Job        @relation(fields: [jobId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  assigneeId   String
  assignee     User       @relation("SubtaskAssignee", fields: [assigneeId], references: [id])

  title                     String
  description               String?
  /// Null until the department commits a date, or the MD sets one.
  /// A row that already had a date when this became optional stays committed.
  deadline                  DateTime?
  /// DEPARTMENT when the assignee committed it, MD when he set or moved it.
  /// Null while there is no date. Existing dates are backfilled as DEPARTMENT.
  deadlineOrigin            DeadlineOrigin?
  /// When the 24-hour commitment window closes. Null until their turn arrives,
  /// and left in place afterwards as the record of when they were asked.
  commitmentDueAt           DateTime?
  /// Separate from the work-overdue clock, so a missed commitment does not
  /// burn the escalations a later real deadline is entitled to.
  commitmentEscalationCount Int             @default(0)
  commitmentLastEscalatedAt DateTime?
  reminderLeadMinutes       Int             @default(360) // 6 hours
  requiresApproval          Boolean         @default(false)
  dependsOnId               String?
  dependsOn                 Subtask?        @relation("Dep", fields: [dependsOnId], references: [id])
  dependents                Subtask[]       @relation("Dep")

  status          SubtaskStatus @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  completionNote  String?
  escalationCount Int           @default(0)
  lastEscalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems          Problem[]
  comments          Comment[]
  attachments       Attachment[]
  materialCounts    MaterialCount[]
  storeEntries      StoreEntry[]
  batches           SubtaskBatch[]
  deadlineChanges   DeadlineChange[]
  extensionRequests ExtensionRequest[]

  @@index([assigneeId, status, deadline])
  @@index([status, deadline]) // the scheduler's hot index
  @@index([jobId])
}

model Problem {
  id             String          @id @default(cuid())
  subtaskId      String
  subtask        Subtask         @relation(fields: [subtaskId], references: [id])
  raisedById     String
  description    String // min 20 chars enforced in service
  severity       ProblemSeverity @default(MEDIUM)
  status         ProblemStatus   @default(OPEN)
  acknowledgedAt DateTime?
  mdActionNote   String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())

  @@index([status, createdAt])
  @@index([subtaskId])
}

model DeadlineChange {
  id          String    @id @default(cuid())
  subtaskId   String
  subtask     Subtask   @relation(fields: [subtaskId], references: [id])
  /// Null when the MD set the first date on a task that had none.
  oldDeadline DateTime?
  newDeadline DateTime
  reason      String
  changedById String
  createdAt   DateTime  @default(now())

  @@index([subtaskId])
}

model ExtensionRequest {
  id                String    @id @default(cuid())
  subtaskId         String
  subtask           Subtask   @relation(fields: [subtaskId], references: [id])
  requestedById     String
  requestedDeadline DateTime
  reason            String
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById       String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([subtaskId])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Collaboration
// ---------------------------------------------------------------------------

model Comment {
  id        String   @id @default(cuid())
  subtaskId String
  subtask   Subtask  @relation(fields: [subtaskId], references: [id])
  userId    String
  body      String
  createdAt DateTime @default(now())

  @@index([subtaskId, createdAt])
}

/// Accepted and rejected material counts reported on a Production, Quality or
/// QA task. Append-only: each row is one report (a shift, a batch); the task's
/// totals are the sum. A wrong entry is corrected by a new one, never edited.
model MaterialCount {
  id           String        @id @default(cuid())
  subtaskId    String
  subtask      Subtask       @relation(fields: [subtaskId], references: [id])
  /// The batch this report closes, on a Production or Quality task planned in
  /// batches. Null for an ordinary (or hourly QA) report.
  batchId      String?
  batch        SubtaskBatch? @relation(fields: [batchId], references: [id])
  acceptedQty  Int
  rejectedQty  Int
  note         String?
  /// The time slot a report covers (QA's hourly inspection). The date is the
  /// IST day it was recorded on; null for reports without a slot.
  periodStart  DateTime?
  periodEnd    DateTime?
  recordedById String
  recordedBy   User          @relation("MaterialCountRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([subtaskId, createdAt])
}

/// One planned lot of a Production or Quality task.
///
/// Production cannot make the whole quantity at once, and Quality inspects each
/// lot on the day it goes, so these tasks carry several dates instead of one.
/// The task's own `deadline` always mirrors the earliest open batch, which keeps
/// the reminders and overdue chasing working batch by batch. A batch is closed by
/// reporting its accepted and rejected pieces.
model SubtaskBatch {
  id          String          @id @default(cuid())
  subtaskId   String
  subtask     Subtask         @relation(fields: [subtaskId], references: [id])
  /// 1, 2, 3 … in date order when planned.
  sequence    Int
  quantity    Int
  deadline    DateTime
  completedAt DateTime?
  createdById String
  createdBy   User            @relation("SubtaskBatchCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  counts      MaterialCount[]

  @@unique([subtaskId, sequence])
  @@index([subtaskId, completedAt])
}

enum StoreDirection {
  /// Material received from a supplier.
  INWARD
  /// Material issued out of the store (to Production).
  OUTWARD
}

/// Which purchase document the material moved against.
enum PurchaseDocType {
  /// Purchase requisition.
  PR
  /// Purchase order.
  PO
}

/// One line of the store register: material in or out, typed in by Store
/// instead of attaching the supplier's PDF. Append-only, like material counts.
/// Each line is intimated to Production and Planning.
model StoreEntry {
  id             String          @id @default(cuid())
  subtaskId      String
  subtask        Subtask         @relation(fields: [subtaskId], references: [id])
  direction      StoreDirection
  documentType   PurchaseDocType
  /// The PR or PO number, when there is one.
  documentNumber String?
  /// Required for INWARD; optional when issuing out.
  supplierName   String?
  invoiceNumber  String?
  /// The invoice's own date (IST calendar date).
  invoiceDate    DateTime?       @db.Date
  material       String?
  quantity       Int?
  note           String?
  recordedById   String
  recordedBy     User            @relation("StoreEntryRecordedBy", fields: [recordedById], references: [id])
  createdAt      DateTime        @default(now())

  @@index([subtaskId, createdAt])
  @@index([createdAt])
}

/// A customer invoice raised by Accounts against a job. A job may be invoiced
/// in parts (partial dispatches). Money is stored in paise and GST in basis
/// points (1800 = 18%) so totals never pick up floating-point error.
/// A sales bill is raised to the customer against the job's accepted pieces; a
/// purchase bill is a supplier's bill Accounts books against the job.
enum BillType {
  SALES
  PURCHASE
}

model Invoice {
  id             String   @id @default(cuid())
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id])
  billType       BillType @default(SALES)
  /// The supplier on a purchase bill; the customer (optional) on a sales bill.
  partyName      String?
  /// Uniqueness scope for the number: '' for sales bills (our own series), the
  /// lower-cased supplier for purchase bills (each supplier has its own series).
  partyKey       String   @default("")
  invoiceNumber  String
  invoiceDate    DateTime
  quantity       Int
  ratePaise      Int
  gstBasisPoints Int
  note           String?
  createdById    String
  createdBy      User     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@unique([billType, partyKey, invoiceNumber])
  @@index([jobId, invoiceDate])
  @@index([invoiceDate])
}

model Attachment {
  id           String   @id @default(cuid())
  jobId        String?
  job          Job?     @relation(fields: [jobId], references: [id])
  subtaskId    String?
  subtask      Subtask? @relation(fields: [subtaskId], references: [id])
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  /// Soft delete (build spec M10.5, architecture rule 6).
  ///
  /// Additive to SDD section 3.3. A drawing removed from a job is part of why
  /// the job was built the way it was; the row and the object both stay, and
  /// every query filters on this instead.
  deletedAt   DateTime?
  deletedById String?

  @@index([jobId])
  @@index([subtaskId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Notifications and governance
// ---------------------------------------------------------------------------

model Notification {
  pushDeliveries PushDelivery[]
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  type           NotifType
  channel        NotifChannel
  subject        String
  body           String
  entityType     String // 'SUBTASK' | 'JOB' | 'PROBLEM'
  entityId       String
  dedupeKey      String         @unique // idempotency guarantee
  scheduledFor   DateTime
  sentAt         DateTime?
  // When the sweeper gave up, not when it last retried. The health check counts
  // these over the last hour (M11.4): a rate, so that a handful of dead
  // addresses from last year does not read as an outage today.
  failedAt       DateTime?
  status         NotifStatus    @default(PENDING)
  attemptCount   Int            @default(0)
  lastError      String?
  readAt         DateTime?
  createdAt      DateTime       @default(now())

  @@index([status, scheduledFor])
  @@index([userId, readAt])
  @@index([entityType, entityId])
  @@index([status, failedAt])
}

model PushSubscription {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint        String         @unique
  p256dh          String
  auth            String
  sessionFamilyId String
  locale          String         @default("en")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deliveries      PushDelivery[]

  @@index([userId])
  @@index([sessionFamilyId])
}

// Successful devices are skipped when another device needs a retry.
model PushDelivery {
  id             String           @id @default(cuid())
  notificationId String
  notification   Notification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  sentAt         DateTime         @default(now())

  @@unique([notificationId, subscriptionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // SUBTASK_COMPLETED, DEADLINE_EXTENDED...
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  onBehalfOf String? // set when DEPUTY_MD acts for MD
  /// WEB for a signed-in session, TELEGRAM for a linked chat. A chat id is
  /// weaker identification than a session. See docs/TELEGRAM.md.
  source     String   @default("WEB")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

/// A one-time code a person sends the bot to link their own chat.
model TelegramLinkCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// What the bot is waiting for this chat to type or confirm.
///
/// A commitment is written only after the member confirms the resolved date.
/// The proposed date lives here, not in the button, so the confirmation and
/// the write cannot disagree.
model TelegramPending {
  chatId    String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FOCUS, SEVERITY, PROBLEM_LOW, PROBLEM_MEDIUM, PROBLEM_HIGH, OTHER, CONFIRM, FILE, or REJECT.
  kind      String
  subtaskId String
  /// IST wall-clock `YYYY-MM-DDTHH:mm`, set while a commitment waits for confirm.
  deadline  String?
  expiresAt DateTime

  @@index([userId])
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique // date only, IST
  name String
}

model Setting {
  key   String @id
  value Json
}

// Shared state for AppSail instances and restartable scheduled jobs.
model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model SchedulerLease {
  key       String   @id
  owner     String
  expiresAt DateTime
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

model JobTemplate {
  id       String            @id @default(cuid())
  name     String
  isActive Boolean           @default(true)
  items    JobTemplateItem[]
}

model JobTemplateItem {
  id                   String      @id @default(cuid())
  templateId           String
  template             JobTemplate @relation(fields: [templateId], references: [id])
  departmentId         String
  title                String
  offsetHoursBeforeDue Int // 240 = 10 days before job deadline
  reminderLeadMinutes  Int         @default(360)
  dependsOnItemOrder   Int?
  order                Int

  @@index([templateId, order])
}

// ---------------------------------------------------------------------------
// Daily production report (the CNC / VMC book, JGE/PROD/F/03)
//
// A supervisor records every hour of a shift per machine. The final report is
// worked out from those hours; any figure typed over it is kept beside the
// worked-out one, so the approver sees "expected X, entered Y". The approver
// (Planning) approves, and the MD is mailed. The arithmetic lives in
// src/lib/domain/production.ts.
// ---------------------------------------------------------------------------

/// Which book: the CNC book (CNC, TMC, drilling, thread rolling) or the VMC book.
enum ProductionSection {
  CNC
  VMC
}

enum ProductionShift {
  DAY
  NIGHT
}

/// DRAFT while the supervisor fills it; SUBMITTED waits for the approver, who
/// may still correct it; APPROVED is final and has been mailed to the MD.
enum ProductionReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

model ProductionMachine {
  id        String            @id @default(cuid())
  /// As printed in the book: "CNC-01", "VMC-10", "DRILLING-02".
  code      String            @unique
  section   ProductionSection
  sortOrder Int
  isActive  Boolean           @default(true)
  lines     ProductionLine[]

  @@index([section, sortOrder])
}

/// One row of the Cycle Time Master: a part and one of its operations.
model ProductionPart {
  id               String            @id @default(cuid())
  customer         String?
  partName         String
  partNumber       String?
  /// 1 = Op I (CNC-10 / VMC-10), 2 = Op II (…-20), and so on.
  operation        Int
  section          ProductionSection
  /// Standard cycle time in seconds, loading included. Null when the master
  /// has no figure yet.
  standardCycleSec Float?
  isActive         Boolean           @default(true)
  /// Set when a supervisor added the part from the floor; the approver sees it.
  addedById        String?
  addedBy          User?             @relation("ProductionPartAddedBy", fields: [addedById], references: [id])
  createdAt        DateTime          @default(now())
  lines            ProductionLine[]

  @@index([section, isActive])
}

/// One page of the book: one section, one shift, one date.
model ProductionReport {
  id           String                 @id @default(cuid())
  /// The IST calendar date the shift started on.
  date         DateTime               @db.Date
  shift        ProductionShift
  section      ProductionSection
  status       ProductionReportStatus @default(DRAFT)
  /// The first hour of the shift, in UTC.
  shiftStart   DateTime
  /// Hours the shift is planned for (11.5 CNC, 11 VMC at creation).
  shiftHours   Float
  remarks      String?
  supervisorId String
  supervisor   User                   @relation("ProductionReportSupervisor", fields: [supervisorId], references: [id])
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?                  @relation("ProductionReportApprover", fields: [approvedById], references: [id])
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  lines        ProductionLine[]
  changes      ProductionChange[]

  @@unique([date, shift, section])
  @@index([status, date])
}

/// A machine running one part in a shift. A part change mid-shift is a second
/// line on the same machine.
model ProductionLine {
  id                   String            @id @default(cuid())
  reportId             String
  report               ProductionReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  machineId            String
  machine              ProductionMachine @relation(fields: [machineId], references: [id])
  position             Int               @default(0)
  operatorName         String?
  partId               String?
  part                 ProductionPart?   @relation(fields: [partId], references: [id])
  /// The part as the book names it. Null for a machine idle all shift.
  partLabel            String?
  operation            Int?
  /// Machining seconds and loading seconds: the book's "55+10".
  cycleSec             Float?
  loadSec              Float?
  /// The master's figure when the line was set up, kept so a later change to
  /// the master does not rewrite an old report's warnings.
  standardCycleSec     Float?
  /// Typed over the worked-out figure on the final report. Null = not typed over.
  pcsPerHourEntered    Int?
  planQtyEntered       Int?
  actualPlanQtyEntered Int?
  achievedQtyEntered   Int?
  runHoursEntered      Float?
  /// Idle minutes by reason, replacing the hourly totals: {"NO_POWER": 30}.
  idleEntered          Json?
  reworkQty            Int               @default(0)
  rejectionQty         Int               @default(0)
  ncReason             String?
  remarks              String?
  /// The supervisor's reason for keeping figures that differ from the formula.
  warningNote          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  hours                ProductionHour[]

  @@index([reportId])
}

/// One hour of one line: pieces made and any idle time, by reason.
model ProductionHour {
  id           String         @id @default(cuid())
  lineId       String
  line         ProductionLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  /// 0 = the first hour of the shift.
  slot         Int
  qty          Int            @default(0)
  /// Idle minutes by reason: {"NO_POWER": 30, "CLEANING": 15}.
  idle         Json           @default("{}")
  note         String?
  recordedById String
  recordedBy   User           @relation("ProductionHourRecordedBy", fields: [recordedById], references: [id])
  /// When the hour was first recorded; an hour recorded long after it ended is shown as late.
  recordedAt   DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([lineId, slot])
}

/// A figure changed after the report was submitted (by the approver).
model ProductionChange {
  id          String           @id @default(cuid())
  reportId    String
  report      ProductionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  lineId      String?
  /// "CNC-07 · Achieved Qty"
  label       String
  before      String?
  after       String?
  changedById String
  changedBy   User             @relation("ProductionChangeBy", fields: [changedById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([reportId, createdAt])
}

/// The stock of one part on the day the app started counting it: raw material
/// in hand and finished goods made but not dispatched. The daily stock ledger
/// adds Store receipts and moves Production's output from RM to FG, and takes
/// dispatches off FG, from this date on.
model StockOpening {
  id         String   @id @default(cuid())
  /// Lower-cased, trimmed part number: the key jobs are matched on.
  partKey    String   @unique
  partNumber String
  partName   String?
  /// Stock at the start of this IST day.
  asOfDate   DateTime @db.Date
  rmQty      Int
  fgQty      Int
  setById    String
  setBy      User     @relation("StockOpeningSetBy", fields: [setById], references: [id])
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

enum StockMovementKind {
  /// Pieces Production made: off RM, onto FG.
  PRODUCED
  /// Pieces sent to the customer: off FG.
  DISPATCHED
}

/// A line Production (made) or a job manager (dispatched) types against a part
/// for one day. Raw material in comes from the Store register instead.
model StockMovement {
  id           String            @id @default(cuid())
  /// Lower-cased, trimmed part number, as on StockOpening.
  partKey      String
  partNumber   String
  partName     String?
  kind         StockMovementKind
  quantity     Int
  /// The IST calendar date, stored as UTC midnight of that date.
  date         DateTime          @db.Date
  /// DC number for a dispatch; shift or batch for production.
  reference    String?
  note         String?
  recordedById String
  recordedBy   User              @relation("StockMovementRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime          @default(now())

  @@index([partKey, date])
  @@index([date])
}
